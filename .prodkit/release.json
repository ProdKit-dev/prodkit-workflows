{
  "schema_version": 1,
  "version": {
    "sources": [
      {
        "type": "text",
        "path": "VERSION"
      }
    ]
  },
  "notes": {
    "path_template": "docs/V{version}.md",
    "changelog_path": "CHANGELOG.md",
    "changelog_heading_template": "## [{version}]"
  },
  "build": {
    "script": ".prodkit/workflows/release-build.sh",
    "artifact_dir": "dist/release",
    "source_archive": true
  },
  "release": {
    "name_template": "ProdKit Workflows {tag}"
  }
}
