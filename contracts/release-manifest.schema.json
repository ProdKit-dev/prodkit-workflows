{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodkit.dev/schemas/workflows/release-manifest-v1.json",
  "title": "ProdKit release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "notes",
    "build"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "json",
                  "toml"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_template"
      ],
      "properties": {
        "path_template": {
          "type": "string",
          "minLength": 1
        },
        "changelog_path": {
          "type": "string",
          "minLength": 1,
          "default": "CHANGELOG.md"
        },
        "changelog_heading_template": {
          "type": "string",
          "minLength": 1,
          "default": "## [{version}]"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "artifact_dir"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "artifact_dir": {
          "type": "string",
          "minLength": 1
        },
        "source_archive": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name_template": {
          "type": "string",
          "minLength": 1,
          "default": "{repository} {tag}"
        }
      }
    }
  }
}
